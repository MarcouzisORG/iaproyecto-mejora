# macOS
.DS_Store
._*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Entornos / secretos
.env
.env.*
!.env.example

# Datos y artefactos locales: solo se versionan marcadores de directorio.
/data/**
!/data/**/
!/data/**/.gitkeep
/models/**
!/models/**/
!/models/**/.gitkeep
# Pesos publicados del MVP y de la mejora individual.
# Se nombran uno por uno para no subir por error los de experimentos descartados.
!/models/modelo_a_densenet121_v1/modelo.pt
!/models/modelo_b_densenet121_v1/modelo.pt
!/models/modelo_control_v2_densenet121/modelo.pt
!/models/modelo_c_v2_densenet121/modelo.pt
!/models/modelo_[de]_efficientnet_b0/modelo.pt
!/models/modelo_[de]_efficientnet_b0/predicciones_val.csv
!/models/modelo_e_efficientnet_b0/reemplazos_train.csv
!/models/modelo_[de]_efficientnet_b0/evaluacion_*/resultados.png
!/models/modelo_[de]_efficientnet_b0/evaluacion_*/ejemplos.png
!/models/comparacion_*_b_[de]/comparacion_*.png
!/models/comparacion_*_d_e/comparacion_*.png
!/models/comparacion_val_d_e/seleccion_test.json
# Reportes livianos de todos los modelos y comparaciones (trazabilidad de experimentos).
!/models/*/report.json
!/models/*/historial.csv
!/models/*/evaluacion_*/report.json
# Puntaje, etiqueta y paciente de cada imagen evaluada: rx-recalcular rehace las métricas sin NIH.
!/models/*/evaluacion_*/predicciones_*.csv

# Material de la cátedra: queda local, no es parte del proyecto.
/Slides/
/git-profe/
/consigna.pdf

# Empaquetado de Python y temporales
build/
dist/
*.egg-info/
*.log
Thumbs.db

# Archivos intermedios de ejecución de notebooks
/work/

